  "scripts": {
    "dev": "vite dev",
    "build": "NODE_ENV=production vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest --coverage",
    "test-storybook": "test-storybook --url http://127.0.0.1:6006 --includeTags verification",
    "test-storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"http-server storybook-static --port 6006 -c-1 --silent\" \"wait-on tcp:127.0.0.1:6006 && pnpm test-storybook\"",
    "generate": "../scripts/generate-frontend-client.sh",
    "generate:check": "../scripts/check-frontend-client-drift.sh"
  },
