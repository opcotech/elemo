{
  "name": "Elemo",
  "image": "mcr.microsoft.com/devcontainers/base:bullseye",
  "features": {
    "ghcr.io/devcontainers-extra/features/mise:1": {
      "version": "2026.9.1"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [3000, 5432, 6379, 7474, 8025, 35478],
  "portsAttributes": {
    "3000": { "label": "Web App", "protocol": "http" },
    "5432": { "label": "PostgreSQL" },
    "6379": { "label": "Redis" },
    "7474": { "label": "Neo4j", "protocol": "http" },
    "8025": { "label": "SMTP", "protocol": "http" },
    "35478": {
      "label": "Elemo API",
      "protocol": "http",
      "visibility": "public"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["hverlin.mise-vscode"]
    }
  },
  "remoteEnv": {
    "DOCKER_HOST": "unix:///var/run/docker.sock"
  },
  "postCreateCommand": "mise trust && mise bootstrap",
  "updateRemoteUserUID": true
}
