        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(http_request_duration_seconds_count{job=\"elemo-server\"}, handler)",
        "includeAll": true,
        "label": "handler",
        "multi": true,
        "name": "handler",
        "query": { "query": "label_values(http_request_duration_seconds_count{job=\"elemo-server\"}, handler)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "text": "100ms", "value": "100ms" },
        "includeAll": false,
        "label": "slow trace",
        "name": "slow",
        "options": [
          { "text": "50ms", "value": "50ms" },
          { "selected": true, "text": "100ms", "value": "100ms" },
          { "text": "250ms", "value": "250ms" },
          { "text": "500ms", "value": "500ms" },
          { "text": "1s", "value": "1s" },
          { "text": "2s", "value": "2s" }
        ],
        "query": "50ms,100ms,250ms,500ms,1s,2s",
        "type": "custom"
      }
    ]
