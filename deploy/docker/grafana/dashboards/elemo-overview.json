          "expr": "sum(rate(http_request_duration_seconds_count{job=\"elemo-server\", handler=~\"$handler\", code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_request_duration_seconds_count{job=\"elemo-server\", handler=~\"$handler\"}[$__rate_interval])), 1e-9)",
