---
import Form from "../components/Form.astro";
import Layout from "../layouts/Layout.astro";

const githubUrl = "https://github.com/opcotech/elemo";
const contributeUrl = `${githubUrl}/issues?q=is%3Aissue%20state%3Aopen%20milestone%3A%22v0.1.0%20-%20MVP%22%20no%3Aassignee`;
const demoUrl = "https://try.elemo.app";
---

<Layout>
  <a
    class="demo-ribbon"
    href={demoUrl}
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="demo-ribbon-glow" aria-hidden="true"></span>
    <span class="demo-ribbon-text">Try Elemo</span>
    <span class="sr-only"> (opens in a new tab)</span>
  </a>

  <main id="main-content" class="relative flex min-h-svh flex-col overflow-hidden">
    <div class="atmosphere" aria-hidden="true">
      <div class="atmosphere-base"></div>
      <div class="atmosphere-aurora"></div>
      <div class="atmosphere-grid"></div>
      <div class="atmosphere-noise"></div>
    </div>

    <section class="relative z-10 flex flex-1 flex-col px-6 pt-16 pb-0 sm:px-8 sm:pt-20">
      <div class="mx-auto w-full max-w-3xl text-center">
        <p
          class="reveal reveal-delay-1 mb-4 text-[clamp(2.75rem,10vw,5.5rem)] font-bold leading-[0.95] tracking-[-0.04em] text-foreground"
        >
          Elemo
        </p>

        <h1
          class="reveal reveal-delay-2 mb-4 text-balance text-[clamp(1.25rem,3.2vw,1.85rem)] font-semibold leading-snug tracking-tight text-foreground"
        >
          Project work, without the noise
        </h1>

        <p
          class="reveal reveal-delay-3 mx-auto mb-8 max-w-xl text-pretty text-base text-muted-foreground sm:text-lg"
        >
          An open-source workspace for projects, work, documents, and todos. Early, and built in the
          open.
        </p>

        <div class="reveal reveal-delay-4 mx-auto flex w-full max-w-sm flex-col items-center">
          <Form />

          <div
            class="mt-5 flex items-center justify-center gap-x-6 gap-y-2 text-sm text-muted-foreground"
          >
            <a
              href={contributeUrl}
              class="flex items-center gap-x-2 transition-colors hover:text-foreground focus-visible:outline-none"
            >
              <span aria-hidden="true">🤖</span>
              <span
                class="underline underline-offset-2 transition-all duration-200 hover:underline-offset-4"
              >
                Let's build together!
              </span>
            </a>
          </div>
        </div>
      </div>

      <div class="preview-stage reveal reveal-delay-5 mt-12 sm:mt-16">
        <div class="preview-glow" aria-hidden="true"></div>
        <div class="preview-frame">
          <img
            src="/images/demo.png"
            alt="Elemo app showing a Kanban board with work items across Backlog, In Progress, In Review, Blocked, and Done"
            width="3308"
            height="1892"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="preview-image"
          />
        </div>
      </div>
    </section>

    <footer class="relative z-10 px-6 pb-10 pt-8 sm:px-8">
      <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 text-center">
        <p class="text-sm text-muted-foreground">
          Built with ❤️ by Opcotech and the open source community
        </p>
        <nav
          class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2"
          aria-label="Community"
        >
          <a
            href={githubUrl}
            class="text-sm text-muted-foreground transition-colors hover:text-primary focus-visible:outline-none"
          >
            GitHub
          </a>
          <a
            href="https://discord.gg/sx9FPyXAdP"
            class="text-sm text-muted-foreground transition-colors hover:text-primary focus-visible:outline-none"
          >
            Discord
          </a>
          <a
            href="https://join.slack.com/t/elemo-workspace/shared_invite/zt-3a6w9jb46-4uGjtkcqBN9BqBD50xl8eA"
            class="text-sm text-muted-foreground transition-colors hover:text-primary focus-visible:outline-none"
          >
            Slack
          </a>
        </nav>
      </div>
    </footer>
  </main>
</Layout>
